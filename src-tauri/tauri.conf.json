{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen Notes",
  "version": "0.1.0",
  "identifier": "systems.downcast.lumen-notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumen Notes",
        "width": 1280,
        "height": 860,
        "minWidth": 920,
        "minHeight": 620,
        "decorations": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 17 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "nsis"]
  }
}
