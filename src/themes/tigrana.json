ound: #dfdfdf; }\n.app-frame { padding-top: 4px; }\n.app-titlebar { background: var(--tigrana-workspace-background); border-bottom: 0; }\n.note-tab { border-radius: 8px; }\n:scope.theme-light.app-titlebar .note-tab.is-active { background: var(--tigrana-accent); color: var(--tigrana-selected-text); }\n.folder-pane, .notes-pane, .unified-tree-pane, .main-pane, .right-sidebar { border: 0; }\n.pane-header { color: var(--tigrana-text); text-transform: none; font-size: 13px; letter-spacing: 0; padding: 14px; border-bottom: 0; }\n.pane-header strong { font-weight: 500; }\n.topbar { border-bottom: 0; }\n.section-view-folder-pane .folder-row { border-radius: 0; margin-right: 6px; }\n.note-title-input { font-weight: 650; letter-spacing: -0.025em; }\n.ProseMirror h1, .ProseMirror h2, .ProseMirror h3 { font-weight: 600; letter-spacing: -0.015em; }\n.ProseMirror a { color: var(--link-color); text-decoration: underline; text-underline-offset: 3px; }\n.ProseMirror blockquote { border-left: 3px solid var(--tigrana-border); padding: 10px 16px; background: var(--surface-soft); }\n.ProseMirror pre, .ProseMirror table { border: 1px solid var(--tigrana-border); }\n.pane-resizer { background: transparent; }\n.pane-resizer::after { opacity: 0; }\n.pane-resizer:hover::after, .pane-resizer:focus-visible::after { opacity: 1; }\n/* Keep selection slightly translucent to avoid WebKit darkening opaque highlights. */\n:scope.theme-dark .ProseMirror::selection, :scope.theme-dark .ProseMirror *::selection, :scope.theme-dark .note-title-input::selection, :scope.theme-dark .raw-markdown-input::selection { background-color: rgba(98, 98, 98, 0.99); color: #ffffff; }\n:scope.theme-light .note-status-bar { background: var(--tigrana-background); }\n","assets":{},"metrics":{"radius":6,"spacing":1,"lineHeight":1.65}},"light":{"background":"#ffffff","surface":"#f6f6f6","surfaceSoft":"#fafafa","surfaceStrong":"#ffffff","surfaceMuted":"#ededed","border":"#dedede","text":"#292929","textMuted":"#686868","accent